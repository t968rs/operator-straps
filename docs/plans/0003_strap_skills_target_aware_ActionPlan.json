  "decisions": [
    {
      "id": "D1",
      "question": "Where do a project skill's models and API live?",
      "options": [
        {
          "id": "skill-folder",
          "summary": "<skills_dir>/<name>/scripts/, loaded by path"
        },
        {
          "id": "repo-package",
          "summary": "a configured repo package holding every skill's modules"
        },
        {
          "id": "separate-skill",
          "summary": "a second SKILL.md over the same engine"
        }
      ],
      "chosen": "skill-folder",
      "rationale": "Developer pick (approach A): self-contained folder, no repo setup."
    },
    {
      "id": "D2",
      "question": "Does a scaffolded project skill need the harness plugin at runtime?",
      "options": [
        {
          "id": "plugin-required",
          "summary": "heredoc runs through the harness launcher"
        },
        {
          "id": "standalone",
          "summary": "each skill ships its own launcher"
        }
      ],
      "chosen": "plugin-required",
      "rationale": "Developer decision."
    },
    {
      "id": "D3",
      "question": "How does project skill content reach harness code?",
      "options": [
        {
          "id": "bin-shim",
          "summary": "plugins/harness/bin/harness-skill-api on the Bash PATH"
        },
        {
          "id": "env-file",
          "summary": "SessionStart writes HARNESS_ROOT to CLAUDE_ENV_FILE"
        }
      ],
      "chosen": "bin-shim",
      "rationale": "Documented and survives resume; env-file is Bash-only with PowerShell caveats."
    },
    {
      "id": "D4",
      "question": "Default strap.target for a consuming project",
      "options": [
        {
          "id": "project",
          "summary": "project profile by default; this repo sets harness"
        },
        {
          "id": "harness",
          "summary": "harness profile by default"
        }
      ],
      "chosen": "project",
      "rationale": "Only operator-straps writes harness skills."
    },
    {
      "id": "D5",
      "question": "Which key names the project skills folder?",
      "options": [
        {
          "id": "reuse-skills-dir",
          "summary": "the existing top-level skills_dir"
        },
        {
          "id": "strap-skills-dir",
          "summary": "a new strap.skills_dir"
        }
      ],
      "chosen": "reuse-skills-dir",
      "rationale": "One source of truth; review lens detection already reads it."
    },
    {
      "id": "D6",
      "question": "How does a spec record its profile without changing existing spec files?",
      "options": [
        {
          "id": "optional-target",
          "summary": "target: Optional[SkillTarget], plugin_dir Optional, exactly one set; a None target is left out of the dump and the authored digest"
        },
        {
          "id": "profile-field",
          "summary": "a profile field with a default written into every dump"
        }
      ],
      "chosen": "optional-target",
      "rationale": "Existing specs keep text, driver digest and seal byte for byte."
    },
    {
      "id": "D7",
      "question": "Where does ${CLAUDE_PROJECT_DIR} point in a run brief?",
      "options": [
        {
          "id": "run-tree",
          "summary": "the run tree, both arms"
        },
        {
          "id": "source-tree",
          "summary": "the arm's source tree (working tree on green)"
        }
      ],
      "chosen": "run-tree",
      "rationale": "Green writes must land in the scenario tree, where record-run diffs."
    },
    {
      "id": "D8",
      "question": "How does the project API template find the repository root?",
      "options": [
        {
          "id": "cwd-walk",
          "summary": "walk up from the working directory to the folder holding .git"
        },
        {
          "id": "file-walk",
          "summary": "walk up from the module's own file"
        }
      ],
      "chosen": "cwd-walk",
      "rationale": "On green the module loads from the working tree while the runner works in the run tree."
    },
    {
      "id": "D9",
      "question": "How do planned tests reach a project skill's modules?",
      "options": [
        {
          "id": "inline-idiom",
          "summary": "inlined load-by-path that raises ImportError on a missing file"
        },
        {
          "id": "helper",
          "summary": "a scaffolded helper or conftest"
        }
      ],
      "chosen": "inline-idiom",
      "rationale": "A helper would itself be absent at the start commit red runs from."
    },
    {
      "id": "D10",
      "question": "Is the strap-skills SKILL.md change proven through strap-skills itself?",
      "options": [
        {
          "id": "direct-edit",
          "summary": "direct edit; STR-11 self-gate covers it later"
        },
        {
          "id": "strap-now",
          "summary": "add judgment behaviors to the strap-skills spec now"
        }
      ],
      "chosen": "direct-edit",
      "rationale": "The strap-skills spec is unfrozen with zero behaviors; STR-11 is pending."
    }
