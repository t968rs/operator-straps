  "decisions": [
    {
      "id": "D1",
      "question": "What do review JSON stats.additions/deletions/files_changed mean once source counts exist?",
      "options": [
        {
          "id": "keep-totals",
          "summary": "Keep the full totals; add a stats.source sub-object"
        },
        {
          "id": "source-only",
          "summary": "Change them to source-only; move the totals to a sub-object"
        }
      ],
      "chosen": "keep-totals",
      "rationale": "Developer choice: old and new review JSONs keep one meaning."
    },
    {
      "id": "D2",
      "question": "Where do the skills get their DiffDelta?",
      "options": [
        {
          "id": "from-stats",
          "summary": "from_stats over the per-file counts already captured; between() for any two refs"
        },
        {
          "id": "between-only",
          "summary": "Every caller runs between(ref_a, ref_b)"
        },
        {
          "id": "persisted",
          "summary": "Persist the delta in the skeleton and plan.json"
        }
