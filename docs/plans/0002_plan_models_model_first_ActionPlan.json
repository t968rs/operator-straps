  "decisions": [
    {
      "id": "D1",
      "question": "How does an agent hand the driver a plan?",
      "options": [
        {
          "id": "whole-plan-write",
          "summary": "load, model_copy(update=..., deep=True), write the whole plan"
        },
        {
          "id": "piecewise-add",
          "summary": "add_item and add_decision style methods"
        }
      ],
      "chosen": "whole-plan-write",
      "rationale": "The developer chose it; add_* methods come later on top of load and write."
    },
    {
      "id": "D2",
      "question": "Which validator does plan.py use, and what does the schema hook use?",
      "options": [
        {
          "id": "models-in-plan-py",
          "summary": "plan.py validates through the models; the hook validates against a schema JSON"
        },
        {
          "id": "schema-everywhere",
          "summary": "every consumer validates against the schema JSON"
        }
      ],
      "chosen": "models-in-plan-py",
      "rationale": "The developer chose the models as the truth; drift tests keep the generated schema in step."
    },
    {
      "id": "D3",
      "question": "What happens to prAttributes.schema.json?",
      "options": [
        {
          "id": "retire-no-stub",
          "summary": "delete it; the hook reports an unresolvable pinned $ref"
        },
        {
          "id": "keep-stub",
          "summary": "keep a stub file so old pinned copies still resolve"
        }
      ],
      "chosen": "retire-no-stub",
      "rationale": "The developer chose no stub; the hook stops hiding the unresolvable reference."
    }
  ],
