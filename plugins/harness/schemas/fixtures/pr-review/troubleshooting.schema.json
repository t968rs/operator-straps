{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/t968rs/operator-straps/plugins/harness/schemas/fixtures/pr-review/troubleshooting.schema.json",
  "title": "PR Review Troubleshooting Q&A",
  "description": "Q&A recovery recipes for the most common failure modes encountered while running pr-review. SKILL.md cites a sample subset; this file is the source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_meta", "items"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "_meta": {
      "type": "object",
      "description": "Metadata about this catalog",
      "required": ["purpose", "schema_version", "last_reviewed", "eviction_policy"],
      "properties": {
        "purpose": {
          "type": "string",
          "description": "Purpose of this catalog"
        },
        "schema_version": {
          "type": "string",
          "description": "Schema version"
        },
        "last_reviewed": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Date of last review (YYYY-MM-DD)"
        },
        "eviction_policy": {
          "type": "string",
          "description": "Policy for when to evict old entries"
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "description": "Array of troubleshooting Q&A entries",
      "items": {
        "type": "object",
        "required": ["id", "question", "answer"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[0-9]{3}$",
            "description": "Unique identifier (T001, T002, etc.)"
          },
          "question": {
            "type": "string",
            "description": "The troubleshooting question or failure mode"
          },
          "answer": {
            "type": "string",
            "description": "The recovery procedure or answer"
          },
          "recovery_command": {
            "type": ["string", "null"],
            "description": "Optional bash command for recovery (null if no command needed)"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
