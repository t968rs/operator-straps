{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/t968rs/operator-straps/plugins/harness/schemas/fixtures/pr-review/rationalization_table.schema.json",
  "title": "PR Review Rationalization Table",
  "description": "Catalog of observed rationalizations in pr-review skill testing. Each entry pairs a tempting shortcut with the reality that defeats it. Source-of-truth catalog; SKILL.md cites a sample subset.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_meta", "rationalizations"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "_meta": {
      "type": "object",
      "description": "Metadata about this catalog",
      "required": ["purpose", "schema_version", "last_reviewed", "eviction_policy"],
      "properties": {
        "purpose": {
          "type": "string",
          "description": "Purpose of this catalog"
        },
        "schema_version": {
          "type": "string",
          "description": "Schema version"
        },
        "last_reviewed": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Date of last review (YYYY-MM-DD)"
        },
        "eviction_policy": {
          "type": "string",
          "description": "Policy for when to evict old entries"
        }
      },
      "additionalProperties": false
    },
    "rationalizations": {
      "type": "array",
      "description": "Array of rationalization entries",
      "items": {
        "type": "object",
        "required": ["id", "rationalization", "reality", "category"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]{3}$",
            "description": "Unique identifier (R001, R002, etc.)"
          },
          "rationalization": {
            "type": "string",
            "description": "The tempting shortcut or rationalization"
          },
          "reality": {
            "type": "string",
            "description": "The reality that defeats the rationalization"
          },
          "category": {
            "type": "string",
            "description": "Category of the rationalization (e.g., branch_safety, general_skill_discipline, phase3_atomic_close)"
          },
          "originating_pr": {
            "type": ["integer", "string", "null"],
            "description": "PR number where this rationalization was first observed. Null if historical or unknown."
          },
          "last_seen_pr": {
            "type": ["integer", "string", "null"],
            "description": "PR number where this rationalization was most recently observed. Null if never observed in production."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
