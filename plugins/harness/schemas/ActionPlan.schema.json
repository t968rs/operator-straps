{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/t968rs/operator-straps/plugins/harness/schemas/ActionPlan.schema.json",
  "$defs": {
    "ActionItem": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "description": "Item id: 2-4 uppercase letters, a dash, digits and periods (`TASK-3.2`).",
          "pattern": "^[A-Z]{2,4}-[0-9.]+$",
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Priority"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "worktree": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worktree"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "action": {
          "description": "Execution-ready implementation steps; the checklist source of truth.",
          "title": "Action",
          "type": "string"
        },
        "files": {
          "description": "Paths of the files the item changes.",
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "dependencies": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Item ids that finish first.",
          "title": "Dependencies"
        },
        "status": {
          "$ref": "#/$defs/ItemStatus"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "verification_references": {
          "items": {
            "type": "string"
          },
          "title": "Verification References",
          "type": "array"
        },
        "markdown_section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Markdown Section"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "model": {
          "$ref": "#/$defs/ModelName",
          "default": "sonnet",
          "description": "Model that implements the item."
        },
        "anchors": {
          "items": {
            "$ref": "#/$defs/Anchor"
          },
          "title": "Anchors",
          "type": "array"
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/Command"
          },
          "title": "Commands",
          "type": "array"
        },
        "tests": {
          "description": "Pytest node ids that prove the item, each with the exception that fails it before the item is implemented. A planned test file lives at `<plans dir>/<plan_id>/tests/<repo-relative path>`.",
          "items": {
            "$ref": "#/$defs/PlannedTest"
          },
          "title": "Tests",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "action",
        "status",
        "evidence"
      ],
      "title": "ActionItem",
      "type": "object"
    },
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "description": "Repo-relative path and 1-based line or range: `src/x.py:12-18`.",
          "pattern": "^[^:]+:[0-9]+(-[0-9]+)?$",
          "title": "At",
          "type": "string"
        },
        "expect": {
          "description": "Text the range must contain; whitespace runs compare as one space.",
          "minLength": 1,
          "title": "Expect",
          "type": "string"
        }
      },
      "required": [
        "at",
        "expect"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "Command": {
      "additionalProperties": false,
      "properties": {
        "run": {
          "minLength": 1,
          "title": "Run",
          "type": "string"
        },
        "expect": {
          "description": "The output that means the command passed.",
          "minLength": 1,
          "title": "Expect",
          "type": "string"
        },
        "writes": {
          "description": "Files a generation command writes, default outputs and working-directory side effects included.",
          "items": {
            "type": "string"
          },
          "title": "Writes",
          "type": "array"
        }
      },
      "required": [
        "run",
        "expect"
      ],
      "title": "Command",
      "type": "object"
    },
    "Context": {
      "additionalProperties": true,
      "properties": {
        "project": {
          "default": "",
          "title": "Project",
          "type": "string"
        },
        "owner": {
          "default": "",
          "title": "Owner",
          "type": "string"
        },
        "deadline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "date",
          "title": "Deadline"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "title": "Context",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^D[0-9]+$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/DecisionOption"
          },
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "chosen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Chosen"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        }
      },
      "required": [
        "id",
        "question",
        "options",
        "chosen"
      ],
      "title": "Decision",
      "type": "object"
    },
    "DecisionOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "summary"
      ],
      "title": "DecisionOption",
      "type": "object"
    },
    "DeferredTopic": {
      "additionalProperties": true,
      "properties": {
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "affected_sites": {
          "items": {
            "type": "string"
          },
          "title": "Affected Sites",
          "type": "array"
        }
      },
      "required": [
        "topic",
        "rationale"
      ],
      "title": "DeferredTopic",
      "type": "object"
    },
    "Frozen": {
      "additionalProperties": true,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Tree",
          "type": "string"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree",
        "date",
        "digest"
      ],
      "title": "Frozen",
      "type": "object"
    },
    "ItemStatus": {
      "description": "Status of an action item; only `plan.py record` moves an item once its plan is frozen.",
      "enum": [
        "PENDING",
        "IN_PROGRESS",
        "COMPLETE",
        "CLOSED_NO_ACTION",
        "BLOCKED"
      ],
      "title": "ItemStatus",
      "type": "string"
    },
    "MarkdownSync": {
      "description": "Marker that the companion markdown trails the JSON.",
      "enum": [
        "pending_markdown_sync",
        "in_sync"
      ],
      "title": "MarkdownSync",
      "type": "string"
    },
    "ModelName": {
      "description": "The model tier that implements an item when it is dispatched.",
      "enum": [
        "haiku",
        "sonnet",
        "opus"
      ],
      "title": "ModelName",
      "type": "string"
    },
    "PlanFormat": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "example": {
          "minLength": 1,
          "title": "Example",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Anchor"
        }
      },
      "required": [
        "name",
        "example",
        "source"
      ],
      "title": "PlanFormat",
      "type": "object"
    },
    "PlannedTest": {
      "additionalProperties": false,
      "properties": {
        "node": {
          "pattern": "^[^:]+\\.py(::[^:]+)+$",
          "title": "Node",
          "type": "string"
        },
        "red": {
          "$ref": "#/$defs/RedException",
          "description": "The exception that fails the test before the item is implemented."
        }
      },
      "required": [
        "node",
        "red"
      ],
      "title": "PlannedTest",
      "type": "object"
    },
    "PrAttributes": {
      "additionalProperties": true,
      "description": "One PR associated with a plan; `pr` is an int, or a string for drafts without a number yet.",
      "properties": {
        "pr": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Pr"
        },
        "review_doc": {
          "anyOf": [
            {
              "pattern": "^docs/PR_REVIEWS/.+\\.json$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Doc"
        },
        "branch": {
          "title": "Branch",
          "type": "string"
        },
        "base_branch": {
          "title": "Base Branch",
          "type": "string"
        },
        "pip_document": {
          "anyOf": [
            {
              "pattern": "^docs/PLANS/.+_PIP\\.md$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pip Document"
        },
        "merged_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "date",
          "title": "Merged At"
        }
      },
      "required": [
        "pr",
        "branch",
        "base_branch"
      ],
      "title": "PrAttributes",
      "type": "object"
    },
    "Priority": {
      "description": "Optional severity or priority of an item.",
      "enum": [
        "critical",
        "important",
        "minor"
      ],
      "title": "Priority",
      "type": "string"
    },
    "RedException": {
      "description": "The exception that fails a planned test before its item is implemented.",
      "enum": [
        "ImportError",
        "AttributeError",
        "AssertionError",
        "NotImplementedError",
        "TypeError"
      ],
      "title": "RedException",
      "type": "string"
    },
    "Sweep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^S[0-9]+$",
          "title": "Id",
          "type": "string"
        },
        "pattern": {
          "description": "Extended regular expression run with `git grep -E` over tracked and untracked files.",
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        },
        "hits": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "description": "Repo-relative file -> classification.",
          "title": "Hits",
          "type": "object"
        }
      },
      "required": [
        "id",
        "pattern",
        "hits"
      ],
      "title": "Sweep",
      "type": "object"
    },
    "Value": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "source": {
          "description": "Where the value comes from: a spec section or a `path:line`.",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "assumes": {
          "description": "Option ids the value depends on.",
          "items": {
            "type": "string"
          },
          "title": "Assumes",
          "type": "array"
        }
      },
      "required": [
        "name",
        "value",
        "source"
      ],
      "title": "Value",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "A unified execution plan: JSON is the source of truth for items, evidence and verification.",
  "properties": {
    "plan_id": {
      "description": "Zero-padded 4-digit sequential plan number, also the filename prefix: `{plan_id}_{Title}_ActionPlan.json` and `{plan_id}_{Title}_PIP.md`.",
      "pattern": "^[0-9]{4}$",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_created": {
      "format": "date",
      "title": "Plan Created",
      "type": "string"
    },
    "completed": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "format": "date",
      "title": "Completed"
    },
    "source_document": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Document"
    },
    "documentation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Documentation"
    },
    "branch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Branch"
    },
    "base_branch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Branch"
    },
    "execution_model": {
      "title": "Execution Model",
      "type": "string"
    },
    "markdown_sync_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/MarkdownSync"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "markdown_last_updated": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "format": "date",
      "title": "Markdown Last Updated"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "pr_attributes": {
      "items": {
        "$ref": "#/$defs/PrAttributes"
      },
      "title": "Pr Attributes",
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ActionItem"
      },
      "title": "Items",
      "type": "array"
    },
    "base_commit": {
      "description": "Commit the plan was written against: the merge base of the base branch and HEAD, recorded by `plan.py new`. Commands name `{base}` instead of a SHA.",
      "pattern": "^[0-9a-f]{40}$",
      "title": "Base Commit",
      "type": "string"
    },
    "frozen": {
      "anyOf": [
        {
          "$ref": "#/$defs/Frozen"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set by `plan.py freeze`: the commit and tree the plan was frozen at and a digest of every field except item status, evidence and verification_references, and the top-level completed, frozen, markdown_sync_status and markdown_last_updated. `plan.py check` reports any later edit outside those fields."
    },
    "decisions": {
      "description": "Design questions the plan settles. `chosen` null means open, which blocks `plan.py freeze`. Every option not chosen counts as rejected.",
      "items": {
        "$ref": "#/$defs/Decision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "values": {
      "description": "Thresholds, counts and bands the plan copies from the spec or the code, with the options each assumes. A value assuming a rejected option fails `plan.py check`.",
      "items": {
        "$ref": "#/$defs/Value"
      },
      "title": "Values",
      "type": "array"
    },
    "formats": {
      "items": {
        "$ref": "#/$defs/PlanFormat"
      },
      "title": "Formats",
      "type": "array"
    },
    "sweeps": {
      "description": "Searches the plan relies on (old names, moved paths). `plan.py check` runs each pattern over tracked and untracked files and fails on a file with hits that `hits` does not classify, or a classified file with none.",
      "items": {
        "$ref": "#/$defs/Sweep"
      },
      "title": "Sweeps",
      "type": "array"
    },
    "deferred_to_future_plans": {
      "items": {
        "$ref": "#/$defs/DeferredTopic"
      },
      "title": "Deferred To Future Plans",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "plan_created",
    "execution_model",
    "items"
  ],
  "title": "ActionPlan",
  "type": "object"
}
