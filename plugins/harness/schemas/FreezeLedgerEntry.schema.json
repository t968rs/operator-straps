{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/t968rs/operator-straps/plugins/harness/schemas/FreezeLedgerEntry.schema.json",
  "$defs": {
    "EntryKind": {
      "enum": [
        "freeze",
        "lock",
        "unlock",
        "arm",
        "reopen",
        "relink"
      ],
      "title": "EntryKind",
      "type": "string"
    },
    "RecordScheme": {
      "description": "How a frozen plan's items prove their status; unset means the legacy references still pass.",
      "enum": [
        "sealed",
        "receipts"
      ],
      "title": "RecordScheme",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "$ref": "#/$defs/EntryKind"
    },
    "round": {
      "minimum": 1,
      "title": "Round",
      "type": "integer"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "tree": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tree"
    },
    "files": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{40}$",
        "type": "string"
      },
      "description": "Repo path to blob SHA of each tree member.",
      "title": "Files",
      "type": "object"
    },
    "ignored": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "description": "Repo path to sha256 of each ignored file.",
      "title": "Ignored",
      "type": "object"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "base": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base"
    },
    "history": {
      "default": false,
      "title": "History",
      "type": "boolean"
    },
    "digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Digest"
    },
    "records": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordScheme"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "skill_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skill Hash"
    },
    "grader": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Grader"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "old_base": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Old Base"
    },
    "new_base": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "New Base"
    },
    "match": {
      "anyOf": [
        {
          "enum": [
            "patch-id",
            "ref"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Match"
    }
  },
  "required": [
    "kind",
    "round",
    "seq",
    "at"
  ],
  "title": "LedgerEntry",
  "type": "object"
}
